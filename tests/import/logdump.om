note logdump: decoder test program for the Cortex log (unit: om/crc32c.om + this file).
note usage: logdump LOG. Prints the header line, one line per record, then END records=N.
note Canonical fields ('|' separated): str/blob = null | t:HEX | b:HEX (uppercase hex of the bytes,
note as sqlite3 hex()); u64/i64/u8 decimal (i64 signed); f64 = f:16 uppercase hex digits of the bits.
note SPACE|rowid|id|slug|created_at
note ENTITY|rowid|ftsrow|id|space_id|space_slug|entity_type|canonical_name|content|aliases_json|
note   metadata_json|confidence|revision|retracted|valid_from|valid_to|created_at|embedding
note CLAIM|rowid|id|space_id|space_slug|subject_entity_id|predicate|object_entity_id|
note   literal_value_json|confidence|metadata_json|retracted|created_at
note ENTITY_RETRACT|id, CLAIM_RETRACT|id, ENTITY_DELETE|id, SPACE_DELETE|slug
note Exit: 0 ok; 2 usage/open; 3 CRCFAIL offset=X; 4 TORN offset=X; 5 BADREC offset=X;
note 6 BADHEADER; 7 write error. Records are read with pread into klr and checked with crc_klr.
text kdname "SPACE\nENTITY\nENTITY_RETRACT\nCLAIM\nCLAIM_RETRACT\nENTITY_DELETE\nSPACE_DELETE\nnull\nEND records=\nCRCFAIL offset=\nTORN offset=\nBADREC offset=\nBADHEADER\n"
text kdmag "CXLOG001"
text kdhex "0123456789ABCDEF"
global kdo uchar 1048576
global kdon ulong 1
global kdp ulong 1
global kde ulong 1
global kdst uchar 128
global kdpath uchar 4100
fn ld_flush to void
n = get kdon 0
d = ulong 0
while lt d n bound 999999
k = write 1 kdo d sub n d
if le k 0
exit 7
end
d = add d ulong k
end
put kdon 0 0
end
fn ld_ob c uchar to void
p = get kdon 0
if ge p len kdo
ld_flush
p = 0
end
put kdo p c
put kdon 0 add p 1
end
fn ld_name k ulong to void
ln = ulong 1
for i ulong len kdname
c = get kdname i
if eq c 10
ln = add ln 1
else
if eq ln k
ld_ob c
end
end
end
end
fn ld_dec v ulong to void
d = new uchar 20 0
n = ulong 0
x = v
while lt n 20 bound 20
put d n uchar add 48 rem x 10
x = div x 10
n = add n 1
if eq x 0
break
end
end
while gt n 0 bound 20
n = sub n 1
ld_ob get d n
end
end
fn ld_fail k ulong off ulong code int to void
ld_name k
ld_dec off
ld_ob 10
ld_flush
exit code
end
fn ld_need n ulong to void
if gt n sub get kde 0 get kdp 0
ld_fail 12 0 5
end
end
fn ld_g8 to ulong
ld_need 1
p = get kdp 0
put kdp 0 add p 1
ret ulong get klr p
end
fn ld_g32 to ulong
ld_need 4
p = get kdp 0
v = ulong 0
for i ulong 4
v = or v shl ulong get klr add p i mul i 8
end
put kdp 0 add p 4
ret v
end
fn ld_g64 to ulong
lo = ld_g32
hi = ld_g32
ret or lo shl hi 32
end
fn ld_hex8 v ulong to void
ld_ob get kdhex shr v 4
ld_ob get kdhex and v 15
end
fn ld_bar to void
ld_ob 124
end
note ld_bytes tag: str/blob field; tag 116 't' or 98 'b'. Chunked: n <= 8388608.
fn ld_bytes tag uchar to void
ld_bar
n = ld_g32
if eq n 4294967295
ld_name 8
ret
end
ld_need n
ld_ob tag
ld_ob 58
p = get kdp 0
i = ulong 0
while lt i n bound 200
m = sub n i
if gt m 65536
m = 65536
end
for j ulong m
ld_hex8 ulong get klr add add p i j
end
i = add i m
end
put kdp 0 add p n
end
fn ld_u64 to void
ld_bar
ld_dec ld_g64
end
fn ld_i64 to void
ld_bar
v = ld_g64
if ge v 9223372036854775808
ld_ob 45
ld_dec add not v 1
ret
end
ld_dec v
end
fn ld_u8 to void
ld_bar
ld_dec ld_g8
end
fn ld_f64 to void
ld_bar
v = ld_g64
ld_ob 102
ld_ob 58
for i ulong 8
ld_hex8 and shr v mul sub 7 i 8 255
end
end
fn ld_strs n ulong to void
for i ulong n
ld_bytes 116
end
end
fn ld_record off ulong to void
op = ld_g8
if or eq op 0 gt op 7
ld_fail 12 off 5
end
ld_name op
if eq op 1
ld_u64
ld_strs 3
end
if eq op 2
ld_u64
ld_u64
ld_strs 8
ld_f64
ld_i64
ld_u8
ld_strs 3
ld_bytes 98
end
if or or eq op 3 eq op 5 or eq op 6 eq op 7
ld_strs 1
end
if eq op 4
ld_u64
ld_strs 7
ld_f64
ld_strs 1
ld_u8
ld_strs 1
end
if ne get kdp 0 get kde 0
ld_fail 12 off 5
end
ld_ob 10
end
fn ld_pread fd int o ulong n ulong pos ulong to void
d = ulong 0
while lt d n bound 999999
k = pread fd klr add o d sub n d long add pos d
if le k 0
ld_fail 11 pos 4
end
d = add d ulong k
end
end
fn ld_one fd int pos ulong size ulong to ulong
if lt sub size pos 8
ld_fail 11 pos 4
end
ld_pread fd 0 8 pos
put kdp 0 0
put kde 0 8
pl = ld_g32
cr = ld_g32
if or gt pl sub len klr 8 gt pl sub sub size pos 8
ld_fail 11 pos 4
end
ld_pread fd 8 pl add pos 8
if ne ulong crc_klr 8 pl cr
ld_fail 10 pos 3
end
put kdp 0 8
put kde 0 add 8 pl
ld_record pos
ret add add pos 8 pl
end
fn main to int
if ne argcnt 2
ret 2
end
n = argread 1 kdpath 0 4090
if lt n 1
ret 2
end
fd = fopen kdpath 0 ulong n 524288 0
if lt fd 0
ret 2
end
r = fstat int fd kdst 0 128
if lt r 0
ret 2
end
size = ulong 0
for i ulong 8
size = or size shl ulong get kdst add 48 i mul i 8
end
if lt size 8
ld_name 13
ld_ob 10
ld_flush
ret 6
end
ld_pread int fd 0 8 0
for i ulong 8
if ne get klr i get kdmag i
ld_name 13
ld_ob 10
ld_flush
ret 6
end
end
for i ulong 8
ld_ob get kdmag i
end
ld_ob 10
pos = ulong 8
cnt = ulong 0
while lt pos size bound 999999
for q ulong 1000
if ge pos size
break
end
pos = ld_one int fd pos size
cnt = add cnt 1
end
end
ld_name 9
ld_dec cnt
ld_ob 10
ld_flush
ret 0
end
