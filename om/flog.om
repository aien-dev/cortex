fn flog_init to void
if eq get qlgi 0 1
ret
end
k = ulong 0
v = ulong 0
dg = false
for i ulong len qlgx
c = ulong get qlgx i
if and ge c 48 le c 57
v = add mul v 10 sub c 48
dg = true
else
if dg
put qlgt k v
k = add k 1
end
v = ulong 0
dg = false
end
end
if dg
put qlgt k v
k = add k 1
end
if ne k 274
trap 9
end
put qlgi 0 1
end
fn flog_t i ulong to f64
ret bitcast f64 get qlgt i
end
note bit length of a 64-bit value (0 for 0)
fn flog_bl x ulong to ulong
n = ulong 0
y = x
if ge y 4294967296
y = shr y 32
n = add n 32
end
if ge y 65536
y = shr y 16
n = add n 16
end
if ge y 256
y = shr y 8
n = add n 8
end
if ge y 16
y = shr y 4
n = add n 4
end
if ge y 4
y = shr y 2
n = add n 2
end
if ge y 2
y = shr y 1
n = add n 1
end
ret add n y
end
fn flog_bl2 h ulong l ulong to ulong
if ne h 0
ret add 64 flog_bl h
end
ret flog_bl l
end
note 64x64 -> 128 product into qfh:qfl
fn flog_mul a ulong b ulong to void
a0 = and a 4294967295
a1 = shr a 32
b0 = and b 4294967295
b1 = shr b 32
flog_mul2 mul a0 b0 mul a0 b1 mul a1 b0 mul a1 b1
end
fn flog_mul2 p00 ulong p01 ulong p10 ulong p11 ulong to void
md = add shr p00 32 and p01 4294967295
md = add md and p10 4294967295
hi = add p11 shr p01 32
hi = add hi shr p10 32
hi = add hi shr md 32
put qfh 0 hi
put qfl 0 or shl md 32 and p00 4294967295
end
note (h:l) << s, s 0..127, into qfh:qfl (bits shifted past 127 are lost; callers never do that)
fn flog_shl h ulong l ulong s ulong to void
if eq s 0
put qfh 0 h
put qfl 0 l
ret
end
if ge s 64
put qfh 0 shl l sub s 64
put qfl 0 0
ret
end
put qfh 0 or shl h s shr l sub 64 s
put qfl 0 shl l s
end
note (h:l) >> s with every lost bit ORed into bit 0 (sticky jam), into qfh:qfl
fn flog_shrs h ulong l ulong s ulong to void
if eq s 0
put qfh 0 h
put qfl 0 l
ret
end
if ge s 128
put qfh 0 0
if ne or h l 0
put qfl 0 1
else
put qfl 0 0
end
ret
end
lost = false
nl = ulong 0
nh = ulong 0
if ge s 64
t = sub s 64
lost = ne l 0
if gt t 0
if ne and h sub shl ulong 1 t 1 0
lost = true
end
nl = shr h t
else
nl = h
end
else
lost = ne and l sub shl ulong 1 s 1 0
nl = or shr l s shl h sub 64 s
nh = shr h s
end
if lost
nl = or nl 1
end
put qfh 0 nh
put qfl 0 nl
end
note bit k of (h:l)
fn flog_bit h ulong l ulong k ulong to ulong
if ge k 64
ret and shr h sub k 64 1
end
ret and shr l k 1
end
note true when some bit below k of (h:l) is set
fn flog_low h ulong l ulong k ulong to bool
if ge k 64
if ne l 0
ret true
end
t = sub k 64
if eq t 0
ret false
end
ret ne and h sub shl ulong 1 t 1 0
end
if eq k 0
ret false
end
ret ne and l sub shl ulong 1 k 1 0
end
note round (h:l) * 2^ex (h:l nonzero, below 2^127) to binary64 with sign sg, nearest-even
fn flog_pack sg ulong ex long h ulong l ulong to f64
lb = long flog_bl2 h l
sh = sub lb 53
er = add ex sh
if lt er -1074
sh = add sh sub -1074 er
er = long -1074
end
m = ulong 0
if le sh 0
m = shl l ulong neg sh
else
if ge sh 128
m = ulong 0
else
s = ulong sh
if ge s 64
m = shr h sub s 64
else
m = or shr l s shl h sub 64 s
end
g = flog_bit h l sub s 1
if eq g 1
if or flog_low h l sub s 1 eq and m 1 1
m = add m 1
end
end
end
end
if eq m 9007199254740992
m = ulong 4503599627370496
er = add er 1
end
if gt er 971
ret bitcast f64 or shl sg 63 9218868437227405312
end
if ge m 4503599627370496
ret bitcast f64 or or shl sg 63 shl ulong add er 1075 52 sub m 4503599627370496
end
ret bitcast f64 or shl sg 63 m
end
note significand and exponent of a finite binary64 bit pattern: value = m * 2^e
fn flog_m u ulong to ulong
f = and u 4503599627370495
if eq and shr u 52 2047 0
ret f
end
ret or f 4503599627370496
end
fn flog_e u ulong to long
b = and shr u 52 2047
if eq b 0
ret long -1074
end
ret sub long b 1075
end
fn flog_nf u ulong to bool
ret eq and shr u 52 2047 2047
end
note fused a*b+c, one rounding to nearest-even
fn flog_fma a f64 b f64 c f64 to f64
ua = bitcast ulong a
ub = bitcast ulong b
uc = bitcast ulong c
if or or flog_nf ua flog_nf ub flog_nf uc
ret add mul a b c
end
ma = flog_m ua
mb = flog_m ub
if or eq ma 0 eq mb 0
ret add mul a b c
end
if eq flog_m uc 0
ret mul a b
end
ret flog_fmb ua ub uc
end
fn flog_fmb ua ulong ub ulong uc ulong to f64
flog_mul flog_m ua flog_m ub
ep = add flog_e ua flog_e ub
ph = get qfh 0
pl = get qfl 0
s = sub 126 flog_bl2 ph pl
flog_shl ph pl s
ret flog_fma2 xor shr ua 63 shr ub 63 sub ep long s shr uc 63 flog_m uc flog_e uc
end
note second half: product P = qfh:qfl * 2^ep (top bit 125), addend C = mc * 2^ec
fn flog_fma2 sp ulong ep long sc ulong mc ulong ec long to f64
ph = get qfh 0
pl = get qfl 0
s = sub 126 flog_bl mc
flog_shl 0 mc s
ch = get qfh 0
cl = get qfl 0
ec2 = sub ec long s
if ge ep ec2
flog_shrs ch cl ulong sub ep ec2
ret flog_addx sp ep ph pl sc
end
flog_shrs ph pl ulong sub ec2 ep
ret flog_addx sc ec2 ch cl sp
end
note X = (xh:xl) * 2^ex with sign sx, Y = qfh:qfl (already aligned) with sign sy
fn flog_addx sx ulong ex long xh ulong xl ulong sy ulong to f64
yh = get qfh 0
yl = get qfl 0
if eq sx sy
lo = add xl yl
cy = ulong 0
if lt lo xl
cy = ulong 1
end
ret flog_pack sx ex add add xh yh cy lo
end
if or gt xh yh and eq xh yh ge xl yl
if and eq xh yh eq xl yl
ret 0.0
end
bw = ulong 0
if lt xl yl
bw = ulong 1
end
ret flog_pack sx ex sub sub xh yh bw sub xl yl
end
bw = ulong 0
if lt yl xl
bw = ulong 1
end
ret flog_pack sy ex sub sub yh xh bw sub yl xl
end
note glibc 2.39 log, main path; ix already adjusted for subnormals
fn flog_main ix ulong to f64
tmp = sub ix 4604367669032910848
i = and shr tmp 45 127
k = long shr tmp 52
if ge tmp 9223372036854775808
k = sub k 4096
end
ret flog_main2 f64 k bitcast f64 sub ix and tmp 18442240474082181120 flog_t add 18 mul i 2 flog_t add 19 mul i 2
end
fn flog_main2 kd f64 z f64 iv f64 lc f64 to f64
w = flog_fma flog_t 0 kd lc
r = flog_fma iv z -1.0
hi = add r w
t5 = flog_fma flog_t 6 r flog_t 5
t3 = flog_fma flog_t 4 r flog_t 3
r2 = mul r r
d = sub w hi
r3 = mul r r2
d = add d r
p = flog_fma t5 r2 t3
d = flog_fma flog_t 1 kd d
d = flog_fma flog_t 2 r2 d
d = flog_fma r3 p d
ret add d hi
end
