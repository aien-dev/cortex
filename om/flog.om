d3 = flog_fma flog_t 13 r2 d3
hi = flog_fma rr flog_t 7 r
d2 = flog_fma flog_t 9 r flog_t 8
d3 = flog_fma d4 r3 d3
d2 = flog_fma flog_t 10 r2 d2
ret flog_near2 r rh hi rr d2 d3
end
fn flog_near2 r f64 rh f64 hi f64 rr f64 d2 f64 d3 f64 to f64
