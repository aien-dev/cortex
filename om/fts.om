for i ulong np
h = sub get qyph add b i 1
put qhsel h 1
put qhs h get qlkb i
put qhc h get qlkc i
end
ret gt get qlkc 0 0
end
note lookahead reader i over phrase h's list; output region at d; returns the next region
fn fts_lkinit i ulong h ulong d ulong to ulong
put qlko i get qhsel h
s = get qhs h
put qlki i s
put qlke i add s get qhc h
put qlkl i 0
z = fts_lknext i
z = fts_lknext i
put qlkb i d
put qlkc i 0
put qlkv i 0
ret add d get qhc h
