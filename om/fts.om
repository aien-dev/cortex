k = s
c1 = ulong 0
for a ulong 9
for j ulong 999999
if or ge k e ne get qer k r
put qkc1 0 c1
ret k
end
if lt get qep k 2147483648
c1 = add c1 1
end
k = add k 1
end
end
trap 9
end
note position iterator t on the first run at or after qxs with a nonempty column selection
fn fts_irun t ulong to void
p = get qxp t
e = get qpe1 p
m = get qxm t
s = get qxs t
for a ulong 9
for j ulong 999999
if ge s e
put qxe t 1
ret
end
k = fts_runend s e
c1 = get qkc1 0
sel = ulong 0
if ne and m 1 0
sel = c1
end
if ne and m 2 0
sel = add sel sub sub k s c1
end
if gt sel 0
put qxs t s
put qxt t k
put qxc t c1
put qxw t ulong get qer s
put qxe t 0
ret
end
s = k
end
end
trap 9
end
fn fts_iopen t ulong to void
put qxs t get qpe0 get qxp t
put qxe t 0
