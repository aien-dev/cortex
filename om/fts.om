if gt n 0
v = ulong 0
for i ulong n
c = fts_qc add p i
if or lt c 48 gt c 57
fts_seterr
ret
end
v = and add mul v 10 sub c 48 4294967295
end
end
d = long v
if ge v 2147483648
d = sub d 4294967296
end
put qyd sub ny 1 d
end
note ---------------- expression nodes (sqlite3Fts5ParseNode and friends) ----------------
note node types: 0 EOF, 1 OR, 2 AND, 3 NOT, 4 TERM, 9 STRING
fn fts_newnode ty ulong ny ulong nch ulong to ulong
o = get qocn 0
c = get qkidn 0
if or ge o QX gt add c nch QX
put qerr 0 2
ret 0
end
put qot o ty
put qox o 1
put qoe o 0
put qonm o 0
put qow o 0
put qoy o ny
put qoh o 0
put qoc o 0
put qocs o c
put qkidn 0 add c nch
put qocn 0 add o 1
ret add o 1
end
note fts5ExprAssignXNext for a STRING node
fn fts_xnext o ulong to void
y = sub get qoy o 1
if eq get qyk y 1
h = sub get qyph get qyp0 y 1
if eq get qhn h 1
if eq get qxf get qht0 h 0
put qot o 4
end
end
end
end
fn fts_child o ulong i ulong to ulong
ret get qkid add get qocs o i
end
fn fts_addch p ulong sub0 ulong to void
o = sub p 1
s = sub sub0 1
ii = get qoc o
ty = get qot o
if and ne ty 3 eq get qot s ty
b = add get qocs o ii
for i ulong get qoc s
put qkid add b i fts_child s i
end
put qoc o add ii get qoc s
else
put qkid add get qocs o ii sub0
put qoc o add ii 1
end
fts_hgt o ii
end
fn fts_hgt o ulong ii ulong to void
for i ulong sub get qoc o ii
ch = sub fts_child o add ii i 1
hh = add get qoh ch 1
if gt hh get qoh o
put qoh o hh
end
end
end
fn fts_node ty ulong l ulong r ulong ny ulong to ulong
if fts_bad
ret 0
end
if eq ty 9
if eq ny 0
ret 0
end
ret fts_strnode ny
end
if eq l 0
ret r
end
if eq r 0
ret l
end
nch = ulong 2
if ne ty 3
if eq get qot sub l 1 ty
nch = add nch sub get qoc sub l 1 1
end
if eq get qot sub r 1 ty
nch = add nch sub get qoc sub r 1 1
end
end
n = fts_newnode ty 0 nch
if eq n 0
ret 0
end
fts_addch n l
fts_addch n r
if gt get qoh sub n 1 256
fts_seterr
ret 0
end
ret n
end
fn fts_strnode ny ulong to ulong
n = fts_newnode 9 ny 0
if eq n 0
ret 0
end
o = sub n 1
fts_xnext o
y = sub ny 1
b = get qyp0 y
for i ulong get qyk y
h = sub get qyph add b i 1
put qhnd h n
if eq get qhn h 0
put qox o 0
put qot o 0
end
end
ret n
end
note sqlite3Fts5ParseImplicitAnd
fn fts_iand l ulong r ulong to ulong
if fts_bad
ret 0
end
pv = l
if eq get qot sub l 1 2
pv = fts_child sub l 1 sub get qoc sub l 1 1
end
if eq get qot sub r 1 0
put qapn 0 sub get qapn 0 1
ret l
end
if eq get qot sub pv 1 0
rt = r
if ne pv l
put qkid add get qocs sub l 1 sub get qoc sub l 1 1 r
rt = l
end
nr = get qyk sub get qoy sub r 1 1
ix = sub sub get qapn 0 1 nr
for i ulong nr
put qap add ix i get qap add add ix i 1
end
put qapn 0 sub get qapn 0 1
ret rt
end
ret fts_node 2 l r 0
end
note sqlite3Fts5ParseSetColset (recursive part)
fn fts_setcs n ulong cs ulong to void
if fts_bad
ret
end
o = sub n 1
ty = get qot o
if or eq ty 9 eq ty 4
y = sub get qoy o 1
old = get qycs y
if ne old 0
m = and and old cs 15
put qycs y or 256 m
if eq m 0
put qot o 0
put qox o 0
end
else
put qycs y cs
end
ret
end
for i ulong get qoc o
fts_setcs fts_child o i cs
end
end
note ---------------- Lemon LALR driver (sqlite3Fts5Parser) ----------------
fn fts_ptab i ulong to ulong
ret get qptab i
end
fn fts_fshift look ulong st ulong to ulong
if gt st 34
ret st
end
i = add fts_ptab add QPS st look
if ne fts_ptab add QPL i look
ret fts_ptab add QPD st
end
ret fts_ptab add QPA i
end
fn fts_freduce st ulong look ulong to ulong
i = sub add fts_ptab add QPR st look 100
ret fts_ptab add QPA i
end
fn fts_shift ns ulong mj ulong to void
t = add get qst 0 1
if gt t 99
fts_seterr
ret
end
s = ns
if gt s 34
s = add s 31
end
put qst 0 t
put qss t s
put qsm t mj
put qsv t get qtkp 0
put qsw t get qtkl 0
end
note feed one token; mirrors sqlite3Fts5Parser for a grammar without an error symbol
fn fts_lp mj ulong to void
act = get qss get qst 0
for j ulong 999999
act = fts_fshift mj act
if ge act 83
rl = sub act 83
if eq fts_ptab add QPN rl 0
if ge get qst 0 99
fts_seterr
ret
end
end
act = fts_reduce rl
else
if le act 79
fts_shift act mj
ret
end
if eq act 81
put qst 0 sub get qst 0 1
ret
end
fts_seterr
ret
end
end
trap 9
end
note reduce by rule rl; returns the new state
fn fts_reduce rl ulong to ulong
m = get qst 0
n = fts_ptab add QPN rl
r = sub add m 1 n
v = fts_ract rl m
if ne rl 0
put qsv r v
end
if eq rl 22
put qsw r 0
end
if eq rl 23
put qsw r get qsw m
end
gt0 = fts_ptab add QPH rl
act = fts_freduce get qss sub m n gt0
put qst 0 r
put qss r act
put qsm r gt0
ret act
end
fn fts_sv i ulong to ulong
ret get qsv i
end
fn fts_sw i ulong to ulong
ret get qsw i
end
note the reduce actions; returns the value for the result slot
fn fts_ract rl ulong m ulong to ulong
if eq rl 0
put qexpr 0 fts_sv m
ret 0
end
if eq rl 1
ret fts_csinv fts_sv sub m 1
end
if eq rl 2
ret fts_sv sub m 1
end
if or eq rl 3 eq rl 6
ret fts_colset 0 fts_sv m fts_sw m
end
if eq rl 4
ret fts_csinv fts_colset 0 fts_sv m fts_sw m
end
if eq rl 5
ret fts_colset fts_sv sub m 1 fts_sv m fts_sw m
end
if eq rl 7
ret fts_node 2 fts_sv sub m 2 fts_sv m 0
end
if eq rl 8
ret fts_node 1 fts_sv sub m 2 fts_sv m 0
end
if eq rl 9
ret fts_node 3 fts_sv sub m 2 fts_sv m 0
end
ret fts_ract2 rl m
end
fn fts_ract2 rl ulong m ulong to ulong
if eq rl 10
fts_setcs2 fts_sv sub m 1 fts_sv sub m 4
ret fts_sv sub m 1
end
if eq rl 11
ret fts_sv sub m 1
end
if or eq rl 12 eq rl 13
ret fts_sv m
end
if eq rl 14
ret fts_iand fts_sv sub m 1 fts_sv m
end
if eq rl 15
ret fts_node 9 0 0 fts_sv m
end
if eq rl 16
n = fts_node 9 0 0 fts_sv m
fts_setcs2 n fts_sv sub m 2
ret n
end
if or eq rl 17 eq rl 20
ret fts_near 0 fts_sv m
end
if eq rl 18
fts_caret fts_sv m
ret fts_near 0 fts_sv m
end
if eq rl 19
fts_pnear fts_sv sub m 4 fts_sw sub m 4
fts_dist fts_sv sub m 2 fts_sv sub m 1 fts_sw sub m 1
ret fts_sv sub m 2
end
if eq rl 21
ret fts_near fts_sv sub m 1 fts_sv m
end
if eq rl 22
ret 0
end
if eq rl 23
ret fts_sv m
end
if eq rl 24
ret fts_term fts_sv sub m 3 fts_sv sub m 1 fts_sw sub m 1 fts_sv m
end
if eq rl 25
ret fts_term 0 fts_sv sub m 1 fts_sw sub m 1 fts_sv m
end
if eq rl 26
ret 1
end
ret 0
end
fn fts_setcs2 n ulong cs ulong to void
if ne n 0
fts_setcs n cs
end
end
note parse qq[0..qqe); leaves qexpr (root node id or 0) and qerr
fn fts_parse to void
put qst 0 0
put qss 0 0
put qsm 0 0
put qtkp 0 0
put qtkl 0 0
for a ulong 2
for j ulong 999999
t = fts_lex
fts_lp t
if or fts_bad eq t 0
ret
end
end
end
trap 9
end
note ---------------- posting entries and term iterators (Fts5IndexIter) ----------------
note decode an encoded position: SQLite's (column << 32) | offset
fn fts_dec e ulong to long
ret long add shl add 1 shr e 31 32 and e 2147483647
end
fn fts_enc p long to ulong
u = ulong p
ret or shl sub shr u 32 1 31 and u 4294967295
end
fn fts_pos sel ulong i ulong to long
if eq sel 0
ret fts_dec ulong get qep i
end
ret fts_dec ulong get qpa i
end
