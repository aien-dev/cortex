b = get qyp0 y
tot = ulong 0
for i ulong np
tot = add tot get qhc sub get qyph add b i 1
end
d = fts_alloc tot
if fts_bad
ret false
end
for i ulong np
d = fts_lkinit i sub get qyph add b i 1 d
end
