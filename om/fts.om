c = get qkc1 0
put qrdi t s
put qrde t add s c
if eq c 0
ret false
end
put qrdp t fts_pos 0 s
ret true
end
note advance reader t; true at EOF
fn fts_rnext t ulong to bool
i = add get qrdi t 1
put qrdi t i
if ge i get qrde t
put qrdp t -1
ret true
end
put qrdp t fts_pos 0 i
ret false
end
fn fts_pmatch h ulong to bool
