put qoe o get qoe nx
put qonm o get qonm nx
end
fn fts_nxor o ulong bfv bool x ulong to void
last = get qow o
for i ulong get qoc o
c = sub fts_child o i 1
if eq get qoe c 0
w = get qow c
mv = eq w last
if bfv
if lt w x
mv = true
end
end
if mv
fts_nnext c bfv x
end
end
end
fts_tor o
end
fn fts_seteof o ulong to void
put qoe o 1
put qonm o 0
for i ulong get qoc o
fts_seteof sub fts_child o i 1
end
end
fn fts_zero o ulong to void
ty = get qot o
if or eq ty 9 eq ty 4
y = sub get qoy o 1
for i ulong get qyk y
put qhc fts_ph y i 0
end
ret
end
for i ulong get qoc o
fts_zero sub fts_child o i 1
end
end
fn fts_tand o ulong to void
last = get qow o
for a ulong 9
for j ulong 999999
put qonm o 0
mt = true
for i ulong get qoc o
c = sub fts_child o i 1
if gt last get qow c
fts_nnext c true last
end
if ne get qoe c 0
fts_seteof o
mt = true
break
end
if ne last get qow c
mt = false
last = get qow c
end
if ne get qonm c 0
put qonm o 1
end
end
if mt
if and ne get qonm o 0 ne o get qroot 0
fts_zero o
end
put qow o last
ret
end
end
end
trap 9
end
fn fts_tnot o ulong to void
p1 = sub fts_child o 0 1
p2 = sub fts_child o 1 1
for a ulong 9
dn = false
for j ulong 999999
if ne get qoe p1 0
dn = true
break
end
cm = fts_ncmp p1 p2
if eq cm 2
fts_nnext p2 true get qow p1
cm = fts_ncmp p1 p2
end
if or ne cm 1 ne get qonm p2 0
dn = true
break
end
fts_nnext p1 false 0
end
if dn
break
end
end
put qoe o get qoe p1
put qonm o get qonm p1
put qow o get qow p1
if ne get qoe p1 0
fts_zero p2
end
end
fn fts_nnext o ulong bfv bool x ulong to void
ty = get qot o
if eq ty 4
fts_nxterm o bfv x
ret
end
if eq ty 9
fts_nxstr o bfv x
ret
end
if eq ty 1
fts_nxor o bfv x
ret
end
if eq ty 2
fts_nnext sub fts_child o 0 1 bfv x
fts_tand o
ret
end
if eq ty 3
fts_nnext sub fts_child o 0 1 bfv x
fts_tnot o
end
end
fn fts_ntest o ulong to void
if ne get qoe o 0
ret
end
ty = get qot o
if eq ty 9
fts_tstr o
ret
end
if eq ty 4
fts_tterm o
ret
end
if eq ty 2
fts_tand o
ret
end
if eq ty 1
fts_tor o
ret
end
if eq ty 3
fts_tnot o
end
end
fn fts_nfirst o ulong to void
put qoe o 0
put qonm o 0
ty = get qot o
if or eq ty 9 eq ty 4
fts_ninit o
else
if eq get qox o 0
put qoe o 1
else
ne1 = ulong 0
for i ulong get qoc o
c = sub fts_child o i 1
fts_nfirst c
ne1 = add ne1 get qoe c
end
put qow o get qow sub fts_child o 0 1
if and eq ty 2 gt ne1 0
fts_seteof o
end
if and eq ty 1 eq ne1 get qoc o
fts_seteof o
end
if eq ty 3
put qoe o get qoe sub fts_child o 0 1
end
end
end
fts_ntest o
end
note sqlite3Fts5ExprFirst / sqlite3Fts5ExprNext (skip rows the root flags as no-match)
fn fts_skipnm o ulong to void
for a ulong 9
for j ulong 999999
if or eq get qonm o 0 ne get qoe o 0
ret
end
fts_nnext o false 0
end
end
trap 9
end
note ---------------- patterns (distinct term/prefix keys) and posting entries ----------------
fn fts_patof t ulong to ulong
for p ulong get qpn 0
if fts_pateq p t
ret p
end
end
p = get qpn 0
put qpb p get qxo t
put qpl p get qxl t
put qpp p get qxr t
put qpn 0 add p 1
ret p
end
fn fts_pateq p ulong t ulong to bool
n = get qxl t
if ne get qpl p n
ret false
end
if ne get qpp p get qxr t
ret false
end
b = get qpb p
o = get qxo t
for i ulong n
if ne get qxb add b i get qxb add o i
ret false
end
end
ret true
end
note mark the term ids matching pattern p with bit bt; returns the occurrence count
fn fts_markp p ulong bt ulong to ulong
o = get qpb p
n = get qpl p
if eq get qpp p 0
t = fts_tid 1 o n false
if eq t QTM
ret 0
end
fts_mark1 t bt
ret ulong get qtmf t
end
cn = ulong 0
nt = get qtmc 0
i = ulong 0
for a ulong 3
for j ulong 999999
if ge i nt
ret cn
end
if ge ulong get qtml i n
if fts_teqp i o n
fts_mark1 i bt
cn = add cn ulong get qtmf i
end
end
i = add i 1
end
end
ret cn
end
fn fts_teqp t ulong o ulong n ulong to bool
b = ulong get qtmo t
for i ulong n
if ne get qtb add b i get qxb add o i
ret false
end
end
ret true
end
fn fts_mark1 t ulong bt ulong to void
m = get qtmk t
if eq m 0
k = get qmkn 0
put qmkl k uint t
put qmkn 0 add k 1
end
put qtmk t or m shl ulong 1 bt
end
fn fts_unmark to void
n = get qmkn 0
i = ulong 0
for a ulong 3
for j ulong 999999
if ge i n
put qmkn 0 0
ret
end
put qtmk ulong get qmkl i 0
i = add i 1
end
end
end
note build posting entries for patterns p0..p1-1 (at most 64): one scan of every row
fn fts_batch p0 ulong p1 ulong to void
w = ulong 0
for k ulong sub p1 p0
p = add p0 k
put qpe0 p w
put qpe1 p w
w = add w get qpcn p
end
for k ulong sub p1 p0
z = fts_markp add p0 k k
end
n = get qsn 0
r = ulong 0
for a ulong 5
for j ulong 999999
if ge r n
fts_unmark
ret
end
fts_scanrow r p0
r = add r 1
end
end
fts_unmark
end
fn fts_scanrow r ulong p0 ulong to void
s = sub ulong get qdst ulong get qsr r 1
n1 = ulong get qtk add s 1
nt = add n1 ulong get qtk add s 2
fts_scandoc r add s 3 n1 nt p0
end
fn fts_scandoc r ulong s ulong n1 ulong nt ulong p0 ulong to void
i = ulong 0
for a ulong 17
for j ulong 999999
if ge i nt
ret
end
m = get qtmk ulong get qtk add s i
if ne m 0
fts_emit r i n1 m p0
end
i = add i 1
end
end
end
fn fts_emit r ulong i ulong n1 ulong m ulong p0 ulong to void
e = i
if ge i n1
e = or 2147483648 sub i n1
end
for b ulong 64
if ne and shr m b 1 0
p = add p0 b
w = get qpe1 p
put qer w uint r
put qep w uint e
put qpe1 p add w 1
end
end
end
note count pattern occurrences, then scan in batches of at most 64 patterns and QE entries
fn fts_postings to void
for p ulong get qpn 0
put qpcn p fts_markp p 0
fts_unmark
end
np = get qpn 0
p0 = ulong 0
while lt p0 np bound 999999
if gt get qpcn p0 QE
put qerr 0 2
ret
end
p1 = add p0 1
tot = get qpcn p0
while lt p1 np bound 64
if or ge sub p1 p0 64 gt add tot get qpcn p1 QE
break
end
tot = add tot get qpcn p1
p1 = add p1 1
end
fts_batch p0 p1
p0 = p1
end
end
note ---------------- bm25 (fts5Bm25Function, k1 1.2, b 0.75) ----------------
note clone phrase h (sqlite3Fts5ExprClonePhrase); returns the clone's node (0-based)
fn fts_clone h ulong to ulong
h2 = fts_newph
if eq h2 0
ret 0
end
t0 = get qht0 h
nt = get qhn h
if gt add get qxn 0 nt QX
put qerr 0 2
ret 0
end
for i ulong nt
fts_cpterm add t0 i
end
put qhn sub h2 1 nt
ny = fts_near 0 h2
if eq ny 0
ret 0
end
oy = get qoy sub get qhnd h 1
put qycs sub ny 1 get qycs sub oy 1
ty = ulong 9
if eq nt 1
if eq get qxf t0 0
ty = ulong 4
end
end
n = fts_newnode ty ny 0
if eq n 0
ret 0
end
put qhnd sub h2 1 n
ret sub n 1
end
fn fts_cpterm s ulong to void
t = get qxn 0
put qxo t get qxo s
put qxl t get qxl s
put qxf t get qxf s
put qxr t get qxr s
put qxn 0 add t 1
end
fn fts_nhit o ulong to ulong
fts_nfirst o
fts_skipnm o
c = ulong 0
for a ulong 9
for j ulong 999999
if ne get qoe o 0
ret c
end
c = add c 1
fts_nnext o false 0
fts_skipnm o
end
end
ret c
end
fn fts_idf to void
nr = get qsn 0
put qavg 0 div f64 long get qtot 0 f64 long nr
for i ulong get qapn 0
put qidf i fts_idf1 nr fts_nhit get qcln i
end
put qidok 0 1
end
fn fts_idf1 nr ulong nh ulong to f64
a = add f64 sub long nr long nh 0.5
b = add f64 long nh 0.5
v = flog div a b
if le v 0.0
ret 1.0e-6
end
ret v
end
note phrase i's instance count at the current root row (sqlite3Fts5ExprPoslist)
fn fts_freq i ulong to f64
h = sub get qap i 1
o = sub get qhnd h 1
if ne get qoe o 0
ret 0.0
end
rw = get qow get qroot 0
if eq get qow o rw
ret f64 get qhc h
end
ret 0.0
end
fn fts_bm25 dt ulong to f64
np = get qapn 0
if eq np 0
ret bitcast f64 ulong 9223372036854775808
end
kk = div mul f64 dt 0.75 get qavg 0
kk = mul add kk 0.25 bitcast f64 ulong 4608083138725491507
s = 0.0f64
i = ulong 0
while lt add i 1 np bound 999999
u0 = fts_bterm kk i
u1 = fts_bterm kk add i 1
s = add s u0
s = add u1 s
i = add i 2
end
if lt i np
f = get qfrq i
t = div mul f bitcast f64 ulong 4612136378390124954 add kk f
s = flog_fma t get qidf i s
end
ret neg s
end
note one lane of the vectorised loop: (f * 2.2) / (K + f) * idf, each operation rounded
fn fts_bterm kk f64 i ulong to f64
f = get qfrq i
t = div mul f bitcast f64 ulong 4612136378390124954 add kk f
ret mul t get qidf i
end
note temp b-tree ORDER BY bm25_rank with LIMIT: stable on ties, keep at most lim rows
fn fts_sort b f64 doc ulong lim ulong to void
n = get qrn 0
if eq n lim
if le get qrb sub n 1 b
ret
end
n = sub n 1
end
p = n
while gt p 0 bound 999999
if le get qrb sub p 1 b
break
end
put qrb p get qrb sub p 1
put qrd p get qrd sub p 1
p = sub p 1
end
put qrb p b
put qrd p doc
put qrn 0 add n 1
end
note ---------------- the search ----------------
fn fts_qreset to void
put qerr 0 0
put qrn 0 0
put qxn 0 0
put qxbn 0 0
put qhcn 0 0
put qyn 0 0
put qyphn 0 0
put qocn 0 0
put qkidn 0 0
put qapn 0 0
put qexpr 0 0
put qpn 0 0
put qpan 0 0
put qpah 0 0
put qidok 0 0
put qmkn 0 0
end
note effective MATCH length: up to the first NUL
fn fts_qlen to ulong
n = get qql 0
if gt n 1048576
n = ulong 1048576
end
i = ulong 0
for a ulong 2
for j ulong 999999
if ge i n
ret n
end
if eq get qq i 0
ret i
end
i = add i 1
end
end
ret n
end
note fts5SpecialMatch for MATCH strings starting with '*': "reads"/"id" give no joined row, others error
fn fts_special to void
z = ulong 1
while eq fts_qc z 32 bound 999999
z = add z 1
end
n = ulong 0
while fts_spc add z n bound 999999
n = add n 1
end
if eq n 5
if and and fts_ci z 114 fts_ci add z 1 101 fts_ci add z 2 97
if and fts_ci add z 3 100 fts_ci add z 4 115
ret
end
end
end
if eq n 2
if and fts_ci z 105 fts_ci add z 1 100
ret
end
end
fts_seterr
end
fn fts_spc i ulong to bool
c = fts_qc i
ret and ne c 0 ne c 32
end
fn fts_ci i ulong ch ulong to bool
ret eq fts_lower fts_qc i ch
end
fn fts_search to ulong
fts_init
fts_qreset
lim = get qlim 0
if ge lim 9223372036854775808
put qerr 0 1
ret 0
end
if gt lim QR
lim = QR
end
if eq lim 0
ret 0
end
put qqe 0 fts_qlen
if gt get qqe 0 0
if eq get qq 0 42
fts_special
ret 0
end
end
fts_parse
if fts_bad
ret 0
end
ret fts_run lim
end
fn fts_run lim ulong to ulong
rt = get qexpr 0
if eq rt 0
rt = fts_newnode 0 0 0
if eq rt 0
ret 0
end
put qox sub rt 1 0
end
put qroot 0 sub rt 1
for i ulong get qapn 0
put qcln i fts_clone sub get qap i 1
end
for t ulong get qxn 0
put qxp t fts_patof t
end
fts_postings
if fts_bad
ret 0
end
o = get qroot 0
fts_nfirst o
fts_skipnm o
for a ulong 5
for j ulong 999999
if or ne get qoe o 0 fts_bad
if fts_bad
put qrn 0 0
end
ret get qrn 0
end
fts_row lim
fts_nnext o false 0
fts_skipnm o
end
end
ret get qrn 0
end
fn fts_row lim ulong to void
o = get qroot 0
doc = ulong get qsr get qow o
if eq get qidok 0 0
fts_idf
end
for i ulong get qapn 0
put qfrq i fts_freq i
end
s = sub ulong get qdst doc 1
b = fts_bm25 add ulong get qtk add s 1 ulong get qtk add s 2
if ne b b
b = 5.0
end
if eq get qok doc 1
fts_sort b doc lim
end
end
