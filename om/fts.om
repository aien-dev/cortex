fn fts_init to void
if eq get qini 0 1
ret
end
uf_init
flog_init
k = ulong 0
v = ulong 0
dg = false
for i ulong len qptx
c = ulong get qptx i
if and ge c 48 le c 57
v = add mul v 10 sub c 48
dg = true
else
if dg
put qptab k v
k = add k 1
end
v = ulong 0
dg = false
end
end
if dg
put qptab k v
k = add k 1
end
if ne k QPT
trap 9
end
put qini 0 1
end
fn fts_rows to ulong
ret get qsn 0
end
fn fts_tokens to ulong
ret get qtot 0
end
note byte i of a key: s 0 = qtf (token just folded), s 1 = qxb at offset o (query term)
fn fts_kb s ulong o ulong i ulong to ulong
if eq s 0
ret ulong get qtf i
end
ret ulong get qxb add o i
end
fn fts_hash s ulong o ulong n ulong to ulong
h = ulong 14695981039346656037
for i ulong n
h = mul xor h fts_kb s o i 1099511628211
end
ret h
end
note true when term t equals the key
fn fts_teq t ulong s ulong o ulong n ulong to bool
if ne ulong get qtml t n
ret false
end
b = ulong get qtmo t
for i ulong n
if ne ulong get qtb add b i fts_kb s o i
ret false
end
end
ret true
end
note term id of the key, or QTM when absent; with ins, add it (QTM when the dictionary is full)
fn fts_tid s ulong o ulong n ulong ins bool to ulong
h = and fts_hash s o n sub QTH 1
while true bound 999999
e = ulong get qth h
if eq e 0
break
end
if fts_teq sub e 1 s o n
ret sub e 1
end
h = and add h 1 sub QTH 1
end
if not ins
ret QTM
end
t = get qtmc 0
b = get qtbn 0
if or ge t sub QTM 1 gt add b n QTB
ret QTM
end
for i ulong n
put qtb add b i uchar fts_kb s o i
end
put qtmo t uint b
put qtml t uint n
put qtmf t 0
put qtbn 0 add b n
put qtmc 0 add t 1
put qth h uint add t 1
ret t
end
note --- big loops: every loop that may pass 1,000,000 times is split as 17 x 999999 ---
note move n words of qtk from src to dst (dst <= src)
fn fts_mvtk dst ulong src ulong n ulong to void
i = ulong 0
for a ulong 17
if ge i n
ret
end
m = sub n i
if gt m 999999
m = ulong 999999
end
for j ulong m
put qtk add dst i get qtk add src i
i = add i 1
end
end
end
fn fts_rlen p ulong to ulong
a = ulong get qtk add p 1
ret add add 3 a ulong get qtk add p 2
end
note compact the token pool: regions [doc, n1, n2, tokens] in start order, dead doc = 2^32-1
fn fts_cmp to void
p = ulong 0
w = ulong 0
e = get qtkn 0
for a ulong 17
for j ulong 999999
if ge p e
put qtkn 0 w
put qtkd 0 0
ret
end
d = ulong get qtk p
ln = fts_rlen p
if ne d 4294967295
if ne w p
fts_mvtk w p ln
end
put qdst d uint add w 1
w = add w ln
end
p = add p ln
end
end
trap 9
end
note first sorted index whose rowid is >= row
fn fts_spos row ulong to ulong
lo = ulong 0
hi = get qsn 0
while lt lo hi bound 64
m = div add lo hi 2
if lt get qdrow ulong get qsr m row
lo = add m 1
else
hi = m
end
end
ret lo
end
fn fts_sins p ulong doc ulong to void
n = get qsn 0
i = n
for a ulong 17
for j ulong 999999
if le i p
put qsr p uint doc
put qsn 0 add n 1
ret
end
put qsr i get qsr sub i 1
i = sub i 1
end
end
trap 9
end
fn fts_sdel p ulong to void
n = sub get qsn 0 1
i = p
for a ulong 17
for j ulong 999999
if ge i n
put qsn 0 n
ret
end
put qsr i get qsr add i 1
i = add i 1
end
end
trap 9
end
fn fts_reset to void
fts_init
for a ulong 17
for j ulong 999999
if eq get qsn 0 0
put qtkn 0 0
put qtkd 0 0
put qtot 0 0
ret
end
fts_del ulong get qsr sub get qsn 0 1
end
end
end
fn fts_del doc ulong to void
if ge doc QD
ret
end
s1 = ulong get qdst doc
if eq s1 0
ret
end
s = sub s1 1
n1 = ulong get qtk add s 1
n2 = ulong get qtk add s 2
nt = add n1 n2
fts_unref add s 3 nt
put qtk s 4294967295
put qtkd 0 add get qtkd 0 add 3 nt
put qtot 0 sub get qtot 0 nt
p = fts_spos get qdrow doc
fts_sdel p
put qdst doc 0
end
fn fts_unref s ulong n ulong to void
i = ulong 0
for a ulong 17
for j ulong 999999
if ge i n
ret
end
t = ulong get qtk add s i
put qtmf t uint sub ulong get qtmf t 1
i = add i 1
end
end
end
note tokenize source src (n bytes) into qtk from w; returns the count, or 2^64-1 on a full dictionary
fn fts_tokcol src ulong n ulong w ulong to ulong
uf_start src n
k = ulong 0
for a ulong 17
for j ulong 999999
if not uf_next
ret k
end
m = get qtfn 0
if gt m 32768
m = ulong 32768
end
t = fts_tid 0 0 m true
if eq t QTM
put qtkf 0 k
ret 18446744073709551615
end
put qtmf t uint add ulong get qtmf t 1
put qtk add w k uint t
k = add k 1
end
end
trap 9
end
fn fts_put doc ulong row ulong to bool
fts_init
if ge doc QD
ret false
end
fts_del doc
p = fts_spos row
if lt p get qsn 0
if eq get qdrow ulong get qsr p row
ret false
end
end
nd = div add get qnml 0 1 2
nd = add nd div add get qctl 0 1 2
nd = add nd 3
if gt add get qtkn 0 nd QTKN
fts_cmp
if gt add get qtkn 0 nd QTKN
ret false
end
end
s = get qtkn 0
put qtk s uint doc
n1 = fts_tokcol 1 get qnml 0 add s 3
if eq n1 18446744073709551615
ret fts_putfail s get qtkf 0
end
n2 = fts_tokcol 0 get qctl 0 add add s 3 n1
if eq n2 18446744073709551615
ret fts_putfail s add n1 get qtkf 0
end
put qtk add s 1 uint n1
put qtk add s 2 uint n2
put qtkn 0 add add s 3 add n1 n2
put qdst doc uint add s 1
put qdrow doc row
fts_sins p doc
put qtot 0 add get qtot 0 add n1 n2
ret true
end
note undo a partly tokenized row (n tokens already counted in qtmf)
fn fts_putfail s ulong n ulong to bool
fts_unref add s 3 n
ret false
end
note ---------------- MATCH expression: lexer (fts5ExprGetToken) ----------------
fn fts_qc i ulong to ulong
if lt i get qqe 0
ret ulong get qq i
end
ret 0
end
note sqlite3Fts5IsBareword
fn fts_bare c ulong to bool
if ge c 128
ret true
end
if or eq c 26 eq c 95
ret true
end
if and ge c 48 le c 57
ret true
end
if and ge c 65 le c 90
ret true
end
ret and ge c 97 le c 122
end
fn fts_bad to bool
ret ne get qerr 0 0
end
fn fts_seterr to void
if not fts_bad
put qerr 0 1
end
end
note next token from position qtkp+qtkl; sets qtkp, qtkl; returns the FTS5 token code
fn fts_lex to ulong
z = add get qtkp 0 get qtkl 0
for a ulong 2
dn = false
for j ulong 999999
c = fts_qc z
if or or eq c 32 eq c 9 or eq c 10 eq c 13
z = add z 1
else
dn = true
break
end
end
if dn
break
end
end
put qtkp 0 z
put qtkl 0 1
c = fts_qc z
if eq c 40
ret 10
end
if eq c 41
ret 11
end
if eq c 123
ret 7
end
if eq c 125
ret 8
end
if eq c 58
ret 5
end
if eq c 44
ret 13
end
if eq c 43
ret 14
end
if eq c 42
ret 15
end
if eq c 45
ret 6
end
if eq c 94
ret 12
end
if eq c 0
ret 0
end
if eq c 34
ret fts_lexq z
end
if not fts_bare c
fts_seterr
ret 0
end
ret fts_lexw z
end
fn fts_lexq z ulong to ulong
z2 = add z 1
for a ulong 2
for j ulong 999999
c = fts_qc z2
if eq c 34
z2 = add z2 1
if ne fts_qc z2 34
put qtkl 0 sub z2 z
ret 9
end
end
if eq fts_qc z2 0
fts_seterr
ret 0
end
z2 = add z2 1
end
end
trap 9
end
fn fts_lexw z ulong to ulong
z2 = add z 1
for a ulong 2
dn = false
for j ulong 999999
if not fts_bare fts_qc z2
dn = true
break
end
z2 = add z2 1
end
if dn
break
end
end
n = sub z2 z
put qtkl 0 n
if eq n 2
if and eq fts_qc z 79 eq fts_qc add z 1 82
ret 1
end
end
if eq n 3
c0 = fts_qc z
c1 = fts_qc add z 1
c2 = fts_qc add z 2
if and and eq c0 78 eq c1 79 eq c2 84
ret 3
end
if and and eq c0 65 eq c1 78 eq c2 68
ret 2
end
end
ret 9
end
note ---------------- parse actions (fts5_expr.c) ----------------
note dequote token qq[p..p+n) into qqt (sqlite3Fts5Dequote); returns the length
fn fts_deq p ulong n ulong to ulong
if ne fts_qc p 34
for i ulong n
put qqt i get qq add p i
end
ret n
end
i = ulong 1
o = ulong 0
while lt i n bound 999999
c = fts_qc add p i
if eq c 34
if ge add i 1 n
ret o
end
if ne fts_qc add add p i 1 34
ret o
end
i = add i 2
put qqt o 34
o = add o 1
else
put qqt o uchar c
o = add o 1
i = add i 1
end
end
ret o
end
fn fts_lower c ulong to ulong
if and ge c 65 le c 90
ret add c 32
end
ret c
end
note column index of qqt[0..n) by sqlite3_stricmp, 4 when unknown
fn fts_colix n ulong to ulong
for k ulong 4
o = ulong 0
m = ulong 2
if eq k 1
o = ulong 3
m = ulong 14
end
if eq k 2
o = ulong 18
m = ulong 7
end
if eq k 3
o = ulong 26
m = ulong 10
end
if eq m n
eq2 = true
for i ulong n
if ne fts_lower ulong get qqt i ulong get qcolx add o i
eq2 = false
end
end
if eq2
ret k
end
end
end
ret 4
end
note colset value: 0 = NULL, 256 + bit mask over columns 0..3
fn fts_colset cs ulong p ulong n ulong to ulong
if fts_bad
ret 0
end
k = fts_colix fts_deq p n
if eq k 4
fts_seterr
ret 0
end
v = cs
if eq v 0
v = ulong 256
end
ret or v shl ulong 1 k
end
fn fts_csinv cs ulong to ulong
if fts_bad
ret 0
end
ret or 256 and not cs 15
end
note new phrase id (1-based) with no terms; terms start at the end of the term pool
fn fts_newph to ulong
h = get qhcn 0
if ge h QX
put qerr 0 2
ret 0
end
put qht0 h get qxn 0
put qhn h 0
put qhnd h 0
put qhsel h 0
put qhs h 0
put qhc h 0
put qhcn 0 add h 1
ret add h 1
end
note append the token in qtf to phrase ph (1-based); terms of ph stay contiguous at the pool end
fn fts_addterm ph ulong to void
h = sub ph 1
t0 = get qht0 h
n = get qhn h
if ne add t0 n get qxn 0
fts_mvph h
t0 = get qht0 h
end
t = get qxn 0
m = get qtfn 0
if gt m 32768
m = ulong 32768
end
b = get qxbn 0
if or ge t QX gt add b m 1048576
put qerr 0 2
ret
end
for i ulong m
put qxb add b i get qtf i
end
put qxbn 0 add b m
put qxo t b
put qxl t m
put qxf t 0
put qxr t 0
put qxn 0 add t 1
put qhn h add n 1
end
note copy the terms of phrase h to the end of the term pool
fn fts_mvph h ulong to void
t0 = get qht0 h
n = get qhn h
t = get qxn 0
if gt add t n QX
put qerr 0 2
ret
end
for i ulong n
put qxo add t i get qxo add t0 i
put qxl add t i get qxl add t0 i
put qxf add t i get qxf add t0 i
put qxr add t i get qxr add t0 i
end
put qht0 h t
put qxn 0 add t n
end
note sqlite3Fts5ParseTerm
fn fts_term app ulong p ulong n ulong pre ulong to ulong
if fts_bad
ret 0
end
m = fts_deq p n
uf_start 2 m
ph = app
for a ulong 2
dn = false
for j ulong 999999
if not uf_next
dn = true
break
end
if eq ph 0
ph = fts_newph
if eq ph 0
ret 0
end
end
fts_addterm ph
if fts_bad
ret 0
end
end
if dn
break
end
end
if eq app 0
k = get qapn 0
if ge k QX
put qerr 0 2
ret 0
end
put qapn 0 add k 1
if eq ph 0
ph = fts_newph
if eq ph 0
ret 0
end
end
end
put qap sub get qapn 0 1 ph
fts_setpre sub ph 1 pre
ret ph
end
fn fts_setpre h ulong pre ulong to void
n = get qhn h
if gt n 0
put qxr add get qht0 h sub n 1 pre
end
end
fn fts_caret ph ulong to void
if ne ph 0
if gt get qhn sub ph 1 0
put qxf get qht0 sub ph 1 1
end
end
end
note sqlite3Fts5ParseNearset
fn fts_near ny ulong ph ulong to ulong
if fts_bad
ret 0
end
if eq ph 0
ret ny
end
y = ny
if eq y 0
k = get qyn 0
if ge k QX
put qerr 0 2
ret 0
end
put qyd k 0
put qycs k 0
put qyp0 k get qyphn 0
put qyk k 0
put qyn 0 add k 1
y = add k 1
else
fts_mvny sub y 1
if fts_bad
ret 0
end
end
ret fts_near2 sub y 1 ph
end
fn fts_near2 y ulong ph0 ulong to ulong
ph = ph0
k = get qyk y
b = get qyp0 y
if gt k 0
last = get qyph add b sub k 1
if eq get qhn sub ph 1 0
k = sub k 1
put qapn 0 sub get qapn 0 1
ph = last
else
if eq get qhn sub last 1 0
put qap sub get qapn 0 2 ph
put qapn 0 sub get qapn 0 1
k = sub k 1
end
end
end
if ge add b k QX
put qerr 0 2
ret 0
end
put qyph add b k ph
put qyk y add k 1
put qyphn 0 add add b k 1
ret add y 1
end
note keep the phrase list of nearset y at the end of the pool
fn fts_mvny y ulong to void
b = get qyp0 y
k = get qyk y
e = get qyphn 0
if eq add b k e
ret
end
if gt add e k QX
put qerr 0 2
ret
end
for i ulong k
put qyph add e i get qyph add b i
end
put qyp0 y e
put qyphn 0 add e k
end
fn fts_pnear p ulong n ulong to void
if ne n 4
fts_seterr
ret
end
