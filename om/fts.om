put qlkp i p
k = get qlki i
if ge k get qlke i
put qlkl i 4611686018427387904
else
put qlkl i fts_pos get qlko i k
put qlki i add k 1
end
ret eq get qlkp i 4611686018427387904
end
fn fts_nmatch y ulong to bool
