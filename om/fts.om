pp = get qlkp i
if or lt pp imin gt pp imax
mt = false
if fts_lkadv i imin
ret 2
end
if gt get qlkp i imax
imax = get qlkp i
end
end
end
put qnmx 0 imax
if mt
ret 0
end
ret 1
end
fn fts_nemit np ulong to void
