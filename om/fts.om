for a ulong 9
for j ulong 999999
put qpip 0 get qrdp t0
for b ulong 9
r = ulong 1
for k ulong 999999
r = fts_pstep t0 nt
if eq r 2
ret
end
if eq r 0
break
end
end
if eq r 0
break
end
end
ip = get qpip 0
if or not bf eq and ulong ip 2147483647 0
c = get qhc h
put qpa add d c uint fts_enc ip
put qhc h add c 1
end
for i ulong nt
if fts_rnext add t0 i
ret
end
end
end
end
end
note one pass of the phrase alignment loop: 0 aligned at qpip, 1 not yet, 2 a reader hit EOF
fn fts_pstep t0 ulong nt ulong to ulong
ip = get qpip 0
mt = true
for i ulong nt
t = add t0 i
adj = add ip long i
if ne get qrdp t adj
mt = false
if fts_radv t adj
ret 2
end
if gt get qrdp t adj
ip = sub get qrdp t long i
end
end
end
put qpip 0 ip
if mt
ret 0
end
ret 1
end
note advance reader t while its position is below adj; true at EOF
fn fts_radv t ulong adj long to bool
for a ulong 9
for j ulong 999999
if ge get qrdp t adj
ret false
end
if fts_rnext t
ret true
end
end
end
trap 9
end
note ---------------- NEAR (fts5ExprNearIsMatch, lookahead readers by phrase slot) ----------------
global qlkb ulong QX
fn fts_lknext i ulong to bool
