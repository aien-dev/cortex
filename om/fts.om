cap = get qkc1 0
d = fts_alloc cap
if fts_bad
ret false
end
put qhsel h 1
put qhs h d
put qhc h 0
for i ulong nt
if not fts_rinit add t0 i
ret false
end
end
fts_pm2 h t0 nt d
ret gt get qhc h 0
end
global qpip long 1
fn fts_pm2 h ulong t0 ulong nt ulong d ulong to void
