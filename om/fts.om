if or ne get qxe t 0 ge get qxw t x
ret
end
end
end
end
note the iterator's current position list: returns the first entry index, count in qkc1
fn fts_idata t ulong to ulong
m = get qxm t
s = get qxs t
c1 = get qxc t
if eq m 1
put qkc1 0 c1
ret s
end
if eq m 2
put qkc1 0 sub sub get qxt t s c1
ret add s c1
end
put qkc1 0 sub get qxt t s
ret s
end
note ---------------- position-list arena (two halves, copying compaction) ----------------
fn fts_alloc n ulong to ulong
if gt add get qpan 0 n QA
fts_acmp
if gt add get qpan 0 n QA
put qerr 0 2
ret 0
end
end
b = add get qpah 0 get qpan 0
put qpan 0 add get qpan 0 n
ret b
end
fn fts_acmp to void
nh = ulong 0
if eq get qpah 0 0
nh = QA
end
w = ulong 0
for h ulong get qhcn 0
if eq get qhsel h 1
s = get qhs h
c = get qhc h
if gt add w c QA
put qerr 0 2
ret
end
d = add nh w
fts_cpa d s c
put qhs h d
w = add w c
end
end
put qpah 0 nh
put qpan 0 w
end
fn fts_cpa d ulong s ulong c ulong to void
