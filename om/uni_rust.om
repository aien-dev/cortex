135 127151 127152 127168 127168 127184 127184 127222 127231 127406 127461 127491 127503 127548 127551 127561 127567 127570 127583 127590 127743 128729 128731 128749 128751 128765 128767 128986 128991 129004 129007 129009 129023 129036 129039 129096 129103 129114 129119 129160 129167 129198 129199 129212 129215 129218 129231 129241 129279 129624 129631 129646 129647 129661 129663 129675 129677 129735 129735 129737 129740 129757 129758 129771 129774 129785 129791 129939 129939 130043 131071 173792 173823 178206 178207 183982 183983 191457 191471 192094 194559 195102 196607 201547 201551 210042 1114111"
global jlt uint 126976
global jkc uint 512
global jki uint 1024
global jdg uint 2048
global jkn ulong 3
global jrs uchar 8388608
global jrsl ulong 1
global jrq uchar 4194304
global jrql ulong 1
global jrl uchar 12582912
global jrll ulong 1
global jrn uchar 6291456
global jrnl ulong 1
global jtro ulong 1
global jtrl ulong 1
global jrdl ulong 1
note ---- tables: jlt[cp] = lowercase of cp (0 = unchanged) for cp < 126976 (no mapping above) ----
fn ru_init to void
p = ulong 0
for r ulong 185
p = num_tnum jtlr p
s = get jtv 0
p = num_tnum jtlr p
c = get jtv 0
p = num_tnum jtlr p
d = get jtv 0
ng = eq get jts 0 1
p = num_tnum jtlr p
st = get jtv 0
for t ulong c
cp = add s mul t st
lc = add cp d
if ng
lc = sub cp d
end
put jlt cp uint lc
end
end
p = 0
for r ulong 302
p = num_tnum jtkc p
put jkc r uint get jtv 0
end
p = 0
for r ulong 928
p = num_tnum jtki p
put jki r uint get jtv 0
end
p = 0
for r ulong 1822
p = num_tnum jtdbg p
put jdg r uint get jtv 0
end
put jkn 0 151
put jkn 1 464
put jkn 2 911
end
note true when cp lies in one of the sorted [lo,hi] pairs of table w: 0 cased (jkc), 1 case-ignorable
note (jki), 2 escaped by <str as Debug> (jdg)
fn ru_inr cp uint w uchar to bool
lo = ulong 0
hi = get jkn ulong w
for it ulong 12
if ge lo hi
ret false
end
md = div add lo hi 2
a = uint 0
b = uint 0
if eq w 0
a = get jkc mul md 2
b = get jkc add mul md 2 1
end
if eq w 1
a = get jki mul md 2
b = get jki add mul md 2 1
end
if eq w 2
a = get jdg mul md 2
b = get jdg add mul md 2 1
end
if lt cp a
hi = md
else
if gt cp b
lo = add md 1
else
ret true
end
end
end
ret false
end
note decode the UTF-8 scalar at jrs[i] (length -> jrdl); an ill-formed byte decodes as 4294967295, length 1
fn ru_dec i ulong n ulong to uint
c = uint get jrs i
put jrdl 0 1
if lt c 128
ret c
end
k = ulong 0
v = uint 0
if eq and c 224 192
k = 1
v = and c 31
end
if eq and c 240 224
k = 2
v = and c 15
end
if eq and c 248 240
k = 3
v = and c 7
end
if or eq k 0 gt add i k sub n 1
ret 4294967295
end
for t ulong k
b = uint get jrs add add i t 1
if ne and b 192 128
ret 4294967295
end
v = or shl v 6 and b 63
end
put jrdl 0 add k 1
ret v
end
fn ru_isws cp uint to bool
if and ge cp 9 le cp 13
ret true
end
if or or eq cp 32 eq cp 133 or eq cp 160 eq cp 5760
ret true
end
if and ge cp 8192 le cp 8202
ret true
end
if or or eq cp 8232 eq cp 8233 or or eq cp 8239 eq cp 8287 eq cp 12288
ret true
end
ret false
end
note str::trim (char::is_whitespace) of jrs[off .. off+n) -> jtro (start), jtrl (length); an all-blank
note input gives start off, length 0 (Rust trim_matches with no rejected char)
fn ru_trim off ulong n ulong to void
e = add off n
p = off
for it ulong 8388609
if ge p e
break
end
cp = ru_dec p e
if not ru_isws cp
break
end
p = add p get jrdl 0
end
if ge p e
put jtro 0 off
put jtrl 0 0
ret
end
for it ulong 8388609
if le e p
break
end
s = sub e 1
for t ulong 3
if le s p
break
end
if ne and get jrs s 192 128
break
end
s = sub s 1
end
cp = ru_dec s e
if ne add s get jrdl 0 e
break
end
if not ru_isws cp
break
end
e = s
end
put jtro 0 p
put jtrl 0 sub e p
end
note sigma context class of the char ending before i (dir false) or starting at i (dir true), skipping
note case-ignorable chars: true when the first other char is cased
fn ru_ctx i ulong n ulong dir bool to bool
for it ulong 8388609
cp = uint 0
if dir
if ge i n
ret false
end
cp = ru_dec i n
i = add i get jrdl 0
else
if eq i 0
ret false
end
s = sub i 1
for t ulong 3
if eq s 0
break
end
if ne and get jrs s 192 128
break
end
s = sub s 1
end
cp = ru_dec s n
if ne add s get jrdl 0 i
cp = 4294967295
s = sub i 1
end
i = s
end
if not ru_inr cp 1
ret ru_inr cp 0
end
end
ret false
end
note encode scalar v as UTF-8 into jrl at o; returns new o
fn ru_enc v uint o ulong to ulong
if lt v 128
put jrl o uchar v
ret add o 1
end
if lt v 2048
put jrl o uchar or 192 shr v 6
put jrl add o 1 uchar or 128 and v 63
ret add o 2
end
if lt v 65536
put jrl o uchar or 224 shr v 12
put jrl add o 1 uchar or 128 and shr v 6 63
put jrl add o 2 uchar or 128 and v 63
ret add o 3
end
put jrl o uchar or 240 shr v 18
put jrl add o 1 uchar or 128 and shr v 12 63
put jrl add o 2 uchar or 128 and shr v 6 63
put jrl add o 3 uchar or 128 and v 63
ret add o 4
end
note lowercase one non-ASCII char of jrs at i (n = end) into jrl at o; returns (new i << 32) | new o
fn ru_lmb i ulong n ulong o ulong to ulong
cp = ru_dec i n
k = get jrdl 0
if eq cp 931
lc = uint 963
if ru_ctx i n false
if not ru_ctx add i 2 n true
lc = 962
end
end
o = ru_enc lc o
ret or shl add i 2 32 o
end
if eq cp 304
put jrl o 105
put jrl add o 1 204
put jrl add o 2 135
ret or shl add i 2 32 add o 3
end
if lt cp 126976
lc = get jlt cp
if ne lc 0
o = ru_enc lc o
ret or shl add i k 32 o
end
end
for t ulong k
put jrl add o t get jrs add i t
end
ret or shl add i k 32 add o k
end
note str::to_lowercase of jrs[0 .. jrsl) -> jrl[0 .. jrll)
fn ru_lower to void
num_init
n = get jrsl 0
o = ulong 0
i = ulong 0
for b ulong 4000
for t ulong 4000
if ge i n
put jrll 0 o
ret
end
c = get jrs i
if lt c 128
if and ge c 65 le c 90
c = add c 32
end
put jrl o c
o = add o 1
i = add i 1
else
r = ru_lmb i n o
i = shr r 32
o = and r 4294967295
end
end
end
put jrll 0 o
end
note needle: lowercase jrq[0 .. jrql) into jrn (uses jrs/jrl as scratch)
fn ru_prep to void
n = get jrql 0
ru_cpqs n false
put jrsl 0 n
ru_lower
m = get jrll 0
ru_cpqs m true
put jrnl 0 m
end
note lower(jrs).contains(lower(jrq)) with the needle prepared by ru_prep
fn ru_contains to bool
ru_lower
m = get jrnl 0
h = get jrll 0
if eq m 0
ret true
end
if gt m h
ret false
end
f = get jrn 0
last = sub h m
i = ulong 0
for b ulong 4000
for t ulong 4000
if gt i last
ret false
end
if eq get jrl i f
if ru_meq i m
ret true
end
end
i = add i 1
end
end
ret false
end
fn ru_meq i ulong m ulong to bool
k = ulong 0
for b ulong 4000
for t ulong 4000
if ge k m
ret true
end
x = get jrn k
if ne get jrl add i k x
ret false
end
k = add k 1
end
end
ret true
end
note copy n bytes: sel false jrq -> jrs, true jrl -> jrn
fn ru_cpqs n ulong sel bool to void
i = ulong 0
for b ulong 4000
for t ulong 4000
if ge i n
ret
end
if sel
x = get jrl i
put jrn i x
else
x = get jrq i
put jrs i x
end
i = add i 1
end
end
end

